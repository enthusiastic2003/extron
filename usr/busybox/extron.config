# BusyBox 1.38.0 seed configuration for Extron.
# Apply with: KCONFIG_ALLCONFIG=... make allnoconfig
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_BUSYBOX=y
CONFIG_STATIC=n
CONFIG_PIE=y
CONFIG_EXTRA_LDFLAGS="-L/home/sirjanh/extron/usr/mlibc-sysroot/lib"
CONFIG_INSTALL_APPLET_SYMLINKS=n
CONFIG_INSTALL_APPLET_DONT=y
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
CONFIG_EXTRA_CFLAGS="-D__extron__"
CONFIG_FEATURE_PATH_OPTIMIZATION=y
CONFIG_PATH_DEFAULT="/bin:/opt/tests:/root"
CONFIG_FEATURE_UTMP=n
CONFIG_FEATURE_WTMP=n

# The shell runs applets in-process, avoiding filesystem links while the
# ramfs is still gaining full POSIX namespace operations.
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_HELP=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=50
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y

# First useful userspace set. More applets are enabled as their underlying
# POSIX facilities become real kernel interfaces.
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_ECHO=y
CONFIG_FALSE=y
CONFIG_HOSTNAME=y
CONFIG_ID=y
CONFIG_LS=y
CONFIG_LN=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_STAT=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TRUE=y
CONFIG_TOUCH=y
CONFIG_UNAME=y
CONFIG_WC=y
CONFIG_MD5SUM=y
CONFIG_CLEAR=y

# Second batch: text, file and archive tools (all built on syscalls the
# kernel already has).
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_TEE=y
CONFIG_DIFF=y
CONFIG_PATCH=y
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_DU=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_STRINGS=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_INSTALL=y
CONFIG_VI=y
CONFIG_LESS=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_ENV=y
CONFIG_DATE=y
CONFIG_EXPR=y
CONFIG_SEQ=y
CONFIG_CP=y
CONFIG_DD=y
CONFIG_KILL=y
CONFIG_SYNC=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_REALPATH=y
CONFIG_YES=y
CONFIG_TAC=y
CONFIG_REV=y
CONFIG_NL=y
CONFIG_FOLD=y
CONFIG_EXPAND=y
CONFIG_CMP=y
CONFIG_SPLIT=y
CONFIG_TRUNCATE=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_MKTEMP=y
CONFIG_WHICH=y
CONFIG_PRINTENV=y
CONFIG_SETSID=y
CONFIG_NOHUP=y
CONFIG_TIMEOUT=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_NEWER=y
CONFIG_FEATURE_FIND_MAXDEPTH=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_FEATURE_FIND_PRUNE=y
CONFIG_FEATURE_GREP_EGREP_ALIAS=y
CONFIG_FEATURE_SED_DASH_I=y
CONFIG_FEATURE_DU_DEFAULT_BLOCKSIZE_1K=y
CONFIG_FEATURE_XARGS_SUPPORT_ZERO_TERM=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_TAIL_FOLLOW=n
CONFIG_FEATURE_CP_REFLINK=n

# Third batch: a real init, login and account tools.
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_KILL_REMOVED=y
CONFIG_FEATURE_KILL_DELAY=1
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_QUIET=n
CONFIG_FEATURE_INIT_SYSLOG=n
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_FEATURE_SECURETTY=n
CONFIG_PASSWD=y
CONFIG_SU=y
CONFIG_ADDUSER=y
CONFIG_ADDGROUP=y
CONFIG_DELUSER=y
CONFIG_DELGROUP=y
CONFIG_CHPASSWD=y
CONFIG_WHOAMI=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_MKFIFO=y
CONFIG_MKNOD=y
CONFIG_FLOCK=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_CHECK_NAMES=y
CONFIG_ASH_ALIAS=y
CONFIG_FEATURE_SYSLOG=n
CONFIG_FEATURE_SYSLOG_INFO=n
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_EXPAND_PRMT=y
