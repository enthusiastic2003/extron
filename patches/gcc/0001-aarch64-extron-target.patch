+aarch64*-*-extron*)
+	# Same as the plain aarch64*-*-elf case just below, except for
+	# glibc-stdint.h in place of newlib-stdint.h.
+	#
+	# newlib-stdint.h picks register-width "fast" integer types
+	# (INT_FAST8_TYPE = int, 4 bytes) — the usual bare-metal/embedded
+	# convention. mlibc's own generic aarch64 sysdeps
+	# (bits/types.h's `#elif defined (__aarch64__)` branch) were
+	# written against glibc's convention instead (INT_FAST8_TYPE =
+	# signed char, 1 byte) — every real aarch64-linux-gnu target uses
+	# glibc-stdint.h, and that is what mlibc was tested against.
+	#
+	# Mismatched, this doesn't fail quietly: mlibc's bits/types.h has
+	# its own _Static_assert comparing sizeof(__mlibc_int_fast8) against
+	# sizeof(__INT_FAST8_TYPE__) specifically to catch exactly this —
+	# a compiler whose ABI notion of "fast" doesn't match what mlibc
+	# assumed. First seen building libgcc against freshly-installed
+	# mlibc headers: sizeof(int) (this target, newlib-stdint.h) doesn't
+	# equal sizeof(signed char) (mlibc's assumption).
+	tm_file="${tm_file} elfos.h gnu-user.h glibc-stdint.h"
+	tm_file="${tm_file} aarch64/aarch64-elf.h aarch64/aarch64-errata.h extron.h"
