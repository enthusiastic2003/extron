--- /dev/null
+++ b/gcc/config/extron.h
@@ -0,0 +1,63 @@
+/* GCC driver defaults for the Extron mlibc userspace ABI.  */
+
+#ifndef GCC_EXTRON_H
+#define GCC_EXTRON_H
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()             \
+  do                                         \
+    {                                        \
+      builtin_define_std ("extron");         \
+      builtin_define_std ("unix");           \
+      builtin_assert ("system=extron");      \
+      builtin_assert ("system=unix");        \
+      builtin_assert ("system=posix");       \
+    }                                        \
+  while (0)
+
+#undef CPP_SPEC
+#define CPP_SPEC "%{pthread:-D_REENTRANT}"
+
+#undef CC1_SPEC
+#define CC1_SPEC GNU_USER_TARGET_CC1_SPEC AARCH64_ERRATA_COMPILE_SPEC
+
+#undef CC1PLUS_SPEC
+#define CC1PLUS_SPEC AARCH64_ERRATA_COMPILE_SPEC
+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "crti%O%s crtbegin%O%s %{!shared:crt0%O%s}"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC \
+  "crtend%O%s crtn%O%s " \
+  "%{Ofast|ffast-math|funsafe-math-optimizations:%{!shared:crtfastmath.o%s}}"
+
+#undef LIB_SPEC
+#define LIB_SPEC "%{pthread:-lpthread} -lc"
+
+/* Keep compiler builtins in libgcc.a, but use the shared unwind runtime for
+   normal dynamic links. Static links need libgcc_eh.a instead.  */
+#undef REAL_LIBGCC_SPEC
+#define REAL_LIBGCC_SPEC                                           \
+  "%{static|static-libgcc:-lgcc -lgcc_eh}"                         \
+  "%{!static:%{!static-libgcc:-lgcc -lgcc_s}"                     \
+  "%{static-libgcc:-lgcc -lgcc_eh}}"
+
+#undef LINK_SPEC
+#define LINK_SPEC "%{h*} "                                      \
+  "%{!shared:%{!static:-dynamic-linker /lib/ld.so}} "           \
+  "%{static:-Bstatic} %{shared:-shared} %{symbolic:-Bsymbolic} " \
+  "%{!static:%{rdynamic:-export-dynamic}} "                     \
+  "%{mbig-endian:-EB} %{mlittle-endian:-EL} -X "                \
+  "-maarch64elf%{mabi=ilp32*:32}%{mbig-endian:b} "              \
+  AARCH64_ERRATA_LINK_SPEC
+
+#define TARGET_POSIX_IO
+
+/* The native Binutils 2.42 port predates GAS's .base64 directive. The
+   Canadian-cross configure probe sees the build machine's assembler, so make
+   the target capability explicit and retain GCC's portable byte encoding. */
+#undef BASE64_ASM_OP
+
+#endif /* GCC_EXTRON_H */
