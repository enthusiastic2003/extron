# x86-64 UEFI build of Extron. Companion to the aarch64 Makefile; shares
# every arch-neutral kernel source and swaps in kernel/arch/x86_64/.
#
#   make -f Makefile.x86_64            # kernel.elf + BOOTX64.EFI + ESP tree
#   make -f Makefile.x86_64 run        # boot it under QEMU + OVMF
#   make -f Makefile.x86_64 check      # headless boot, assert on serial output

BUILD  := build-x86_64
CC     := gcc
LD     := ld
OBJCOPY:= objcopy

# -mno-red-zone / -mcmodel=kernel: interrupt-safe, higher-half code model.
# -mgeneral-regs-only: the kernel never touches x87/SSE, so a user process's
#   FP state survives syscalls and IRQs untouched and context_switch is the one
#   place that FXSAVEs/FXRSTORs it (same invariant the aarch64 build keeps).
CFLAGS := -ffreestanding -O2 -Wall -Wextra -nostdlib -fno-stack-protector \
          -fno-pic -fno-pie -mcmodel=kernel -mno-red-zone -mgeneral-regs-only \
          -fno-omit-frame-pointer -fno-strict-aliasing -MMD -MP \
          -Ikernel/include -Ikernel/arch/x86_64/include -g \
          -Wno-unused-parameter -Wno-missing-field-initializers

# make KTRACK=1: track live kernel-heap allocations by call site; the
# SYS_PROC_DUMP syscall then prints them (leak hunting).
ifeq ($(KTRACK),1)
CFLAGS += -DKHEAP_TRACK
endif

# Shared sources, minus everything that is Raspberry Pi / aarch64 specific.
EXCLUDE := kernel/mm/paging.c kernel/drivers/uart.c kernel/drivers/timer.c \
           kernel/drivers/emmc.c kernel/drivers/mailbox.c kernel/drivers/fb.c \
           kernel/drivers/power.c
C_SRC  := $(filter-out $(EXCLUDE),$(shell find kernel -name '*.c' -not -path 'kernel/arch/*')) \
          $(wildcard kernel/arch/x86_64/*.c)
S_SRC  := $(wildcard kernel/arch/x86_64/*.S) $(wildcard kernel/arch/x86_64/proc/*.S)
OBJ    := $(patsubst %.c,$(BUILD)/%.o,$(C_SRC)) $(patsubst %.S,$(BUILD)/%.o,$(S_SRC))
# lwIP (third_party/lwip, unmodified): compiled into the kernel with its own include
# path and without warnings; configuration and glue are in kernel/net/.
LWIP_DIR  := third_party/lwip/src
LWIP_SRC  := $(wildcard $(LWIP_DIR)/core/*.c $(LWIP_DIR)/core/ipv4/*.c) $(LWIP_DIR)/netif/ethernet.c
LWIP_OBJ  := $(patsubst %.c,$(BUILD)/%.o,$(LWIP_SRC))
OBJ    += $(LWIP_OBJ)
DEPS   := $(OBJ:.o=.d)
LWIP_CFLAGS := -w -I$(LWIP_DIR)/include -Ikernel/net/include -Ikernel/net/shim
# Our own glue (kernel/net/*.c) sees lwIP's headers and options too.
$(BUILD)/kernel/net/%.o: CFLAGS += -I$(LWIP_DIR)/include -Ikernel/net/include
$(LWIP_OBJ): CFLAGS += $(LWIP_CFLAGS)

KERNEL_ELF := $(BUILD)/kernel.elf
LOADER     := $(BUILD)/BOOTX64.EFI
ESP        := $(BUILD)/esp
INITRD     ?= initrd.ext2
AUTOEXIT   ?= 0

LOADER_CFLAGS := -ffreestanding -fno-stack-protector -fshort-wchar -mno-red-zone \
                 -fpie -O2 -Wall -Wextra -mgeneral-regs-only -fno-builtin \
                 -fno-ident -fno-asynchronous-unwind-tables -Iboot/uefi

OVMF_CODE ?= /usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS ?= /usr/share/OVMF/OVMF_VARS_4M.fd
QEMU      ?= qemu-system-x86_64
QEMU_MEM  ?= 512M
QEMU_DISPLAY ?= none

# Root disk: a raw ext2 image attached as a legacy virtio-blk device (/dev/vda);
# the kernel boots from it (root=/dev/vda on the command line the ESP carries).
# Created on first use, never overwritten (`make rootfs` rebuilds the system part
# and keeps /root, /home and /mnt; `make disk-clean` starts over).
DISK      ?= $(BUILD)/rootfs.img
DISK_MB   ?= 512
DISK_QEMU  = -drive if=none,id=data0,format=raw,file=$(DISK) \
             -device virtio-blk-pci,drive=data0,disable-modern=on
DISK_ARGS  = $(if $(wildcard $(DISK)),$(DISK_QEMU))

# A virtio-net NIC on QEMU's user-mode network: no host setup, DHCP gives the guest 10.0.2.15,
# the host is 10.0.2.2, DNS 10.0.2.3, and the host's internet is reachable through NAT.
NET_ARGS  ?= -netdev user,id=n0,hostfwd=tcp::2222-:22 -device virtio-net-pci,netdev=n0,disable-modern=on

# What the ESP carries. Default: a tiny initramfs whose /init mounts root=/dev/vda
# and switches to it (USE_INITRD=0: no initramfs, the kernel mounts root= itself).
# `make check` (the libc-free smoke test) uses an initrd as root, no command line.
USE_INITRD ?= 1
CMDLINE    ?= root=/dev/vda rw
TEST_DISK  := $(BUILD)/rootfs-test.img

all: $(KERNEL_ELF) $(LOADER) esp

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(KERNEL_ELF): $(OBJ) kernel/arch/x86_64/linker.ld
	$(LD) -nostdlib -z max-page-size=0x1000 -T kernel/arch/x86_64/linker.ld -o $@ $(OBJ)

$(BUILD)/loader.o: boot/uefi/loader.c boot/uefi/efi.h
	@mkdir -p $(dir $@)
	$(CC) $(LOADER_CFLAGS) -c $< -o $@

$(LOADER): $(BUILD)/loader.o
	$(LD) -m i386pep --subsystem 10 -e efi_main --image-base 0x100000 -s -o $@ $<

# FAT ESP tree (QEMU serves it directly with -drive file=fat:rw:...).
esp: $(KERNEL_ELF) $(LOADER) $(if $(filter 1,$(USE_INITRD)),$(INITRD))
	@mkdir -p $(ESP)/EFI/BOOT $(ESP)/extron
	cp $(LOADER) $(ESP)/EFI/BOOT/BOOTX64.EFI
	cp $(KERNEL_ELF) $(ESP)/extron/kernel.elf
	@if [ "$(USE_INITRD)" = 1 ]; then cp $(INITRD) $(ESP)/extron/initrd.ext2; \
	 else rm -f $(ESP)/extron/initrd.ext2; fi
	@if [ -n "$(CMDLINE)" ]; then printf '%s\n' "$(CMDLINE)" > $(ESP)/extron/cmdline.txt; \
	 else rm -f $(ESP)/extron/cmdline.txt; fi

$(BUILD)/OVMF_VARS.fd: $(OVMF_VARS)
	@mkdir -p $(BUILD)
	cp $< $@

QEMU_ARGS = -machine q35 -m $(QEMU_MEM) -cpu max -display $(QEMU_DISPLAY) \
            -drive if=pflash,format=raw,unit=0,readonly=on,file=$(OVMF_CODE) \
            -drive if=pflash,format=raw,unit=1,file=$(BUILD)/OVMF_VARS.fd \
            -drive format=raw,file=fat:rw:$(ESP) \
            $(DISK_ARGS) $(NET_ARGS) \
            -serial stdio -no-reboot

# The root filesystem image, built on first use from the userland, libraries,
# coreutils, bash and Python (whichever are built).
$(DISK):
	tools/build_x86_rootfs.sh $@ $(DISK_MB)

disk: $(DISK)

# Rebuild the system part of the root disk (new binaries, libraries, config) and
# keep the user's /root, /home and /mnt.
rootfs:
	KEEP=1 tools/build_x86_rootfs.sh $(DISK) $(DISK_MB)

# Refresh only the test programs on the existing disk, keeping everything else.
disk-tests: $(DISK)
	tools/refresh_disk_tests.sh $(DISK)

disk-clean:
	rm -f $(DISK)

# A pristine copy of the system the check-* targets copy for each boot (they
# modify their disk; the real one is never touched).
ROOTFS_INPUTS := $(wildcard $(BUILD)/userland/out/busybox $(BUILD)/userland/out/tests/* \
                 $(BUILD)/userland/sysroot/usr/lib/libc.so $(BUILD)/coreutils/rootfs/usr/bin/coreutils \
                 $(BUILD)/bash/rootfs/usr/bin/bash $(BUILD)/make/rootfs/usr/bin/make $(BUILD)/tcc/rootfs/usr/bin/tcc $(BUILD)/doom/doom $(BUILD)/python/rootfs/usr/bin/python3.14 \
                 $(BUILD)/extlibs/prefix/lib/*.so.* usr/x86_64/tests/* usr/hello.txt)
$(TEST_DISK): $(ROOTFS_INPUTS) tools/build_x86_rootfs.sh
	tools/build_x86_rootfs.sh $@ 256
rootfs-test: $(TEST_DISK)

# Boot, write files to the data disk, kill QEMU, boot again, verify them,
# and fsck the image on the host.
check-persist: esp $(TEST_DISK)
	python3 tools/x86_persist_test.py

# Boot through init/getty/login: accounts, permissions, respawn, poweroff.
check-boot: esp $(TEST_DISK)
	python3 tools/x86_boot_test.py

# C libraries behind Python's optional modules (zlib, bzip2, xz, zstd, libffi,
# ncurses, readline, sqlite) as static archives in build-x86_64/extlibs/prefix.
libs:
	tools/build_x86_libs.sh

# GNU coreutils (multi-call binary, installed in /usr/bin; needs the userland first).
coreutils:
	tools/build_x86_coreutils.sh

# GNU bash 5.3 (/bin/bash, the login shell; needs the userland first).
bash:
	tools/build_x86_bash.sh

# GNU make (/usr/bin/make; needs the userland first).
gnumake:
	tools/build_x86_make.sh

# Tiny C Compiler as the system's `cc` (plus the headers and link files; needs the userland first).
tcc:
	tools/build_x86_tcc.sh

# DOOM (doomgeneric + the shareware WAD; /usr/bin/doom; needs the userland first).
doom:
	tools/build_x86_doom.sh

# CPython 3.14 (installed under /usr; needs the userland first; a few minutes).
python:
	tools/build_x86_python.sh

# Hung-disk timeout/recovery and RTC write-back (one boot, ~20 s).
check-disk: esp $(TEST_DISK)
	python3 tools/x86_disk_timeout_test.py

# DOOM on the framebuffer: takes the display, animates, reacts to PS/2 keys, Ctrl-C
# brings the text console back (needs `make doom`; ~40 s).
check-doom: esp $(TEST_DISK)
	python3 tools/x86_doom_test.py

# Networking: DHCP, DNS, HTTP downloads from a host-side server, listening in the guest.
check-net: esp $(TEST_DISK)
	python3 tools/x86_net_test.py

# Boot flow AND the full regression suite in one boot (one QEMU, one login).
check-all: esp $(TEST_DISK)
	python3 tools/x86_boot_test.py --runtests

run: QEMU_DISPLAY = gtk
run: esp $(BUILD)/OVMF_VARS.fd $(DISK) disk-tests
	$(QEMU) $(QEMU_ARGS)

# Headless boot under OVMF; passes iff the smoke test reports success.
check: $(BUILD)/OVMF_VARS.fd
	@$(MAKE) -f Makefile.x86_64 --no-print-directory INITRD=initrd-check.ext2 AUTOEXIT=1 USE_INITRD=1 CMDLINE= esp >/dev/null
	@rm -f $(BUILD)/serial.log
	@timeout 60 $(QEMU) $(subst -serial stdio,-serial file:$(BUILD)/serial.log,$(QEMU_ARGS)) || true
	@grep -q 'SMOKE TEST PASSED' $(BUILD)/serial.log \
	    && echo "x86-64 UEFI boot + smoke test: PASS" \
	    || { echo "x86-64 UEFI boot + smoke test: FAIL (see $(BUILD)/serial.log)"; tail -30 $(BUILD)/serial.log; exit 1; }

# Build the bring-up initrd (freestanding smoke-test payload as /bin/sh).
$(INITRD): tools/build_x86_initrd.sh usr/x86_64/init.c usr/x86_64/initramfs_init.c \
           $(wildcard $(BUILD)/userland/out/busybox $(BUILD)/userland/out/initramfs-init)
	AUTOEXIT=$(AUTOEXIT) tools/build_x86_initrd.sh $@

# Build mlibc + BusyBox + test programs into build-x86_64/userland (network needed).
userland:
	tools/build_x86_userland.sh

# Boot the BusyBox image and run the whole mlibc regression suite in the guest.
check-userland: esp $(TEST_DISK)
	python3 tools/x86_run_tests.py -n 1

# Repeat the suite N times (default 10) to shake out races, leaks and hangs.
SOAK ?= 10
soak: esp $(TEST_DISK)
	python3 tools/x86_run_tests.py -n $(SOAK) --log $(BUILD)/soak.log

# compile_commands.json for IDE navigation (IntelliJ/CLion, clangd).
compdb:
	tools/gen_compile_commands.py Makefile.x86_64

clean:
	rm -rf $(BUILD)

.PHONY: all esp run check clean compdb userland check-userland soak disk rootfs rootfs-test disk-tests disk-clean check-persist libs python coreutils bash gnumake tcc doom check-boot check-disk check-all check-doom check-net
-include $(DEPS)
