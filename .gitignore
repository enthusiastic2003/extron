build/
initrd.tar

# ext2_host/'s own build products (see its Makefile) — the synthetic
# test image and the compiled test binary. Both regenerate with
# `make -C ext2_host test`; only the harness sources are tracked.
ext2_host/ext2_test
ext2_host/ext2.img
ext2_host/mnt_ext2_test/

# HDMI capture frames (tools/capture.sh). Debugging artefacts, and PNGs
# of a 1280x720 screen add up fast — keep them out of history. Commit an
# individual frame deliberately if one ever documents something worth
# keeping, e.g. a reference shot of a framebuffer bug.
captures/

# doomgeneric upstream, cloned by hand (see doom_roadmap.md). Not
# vendored into history: it's a large third-party tree we don't modify —
# our port is usr/doom/doomgeneric_extron.c, which IS tracked.
third_party/*

# The upstream mlibc checkout remains unvendored, but Extron's platform
# boundary is part of this OS and must be present in a fresh clone.
!third_party/mlibc/
third_party/mlibc/*
!third_party/mlibc/cross-aarch64-extron.ini
!third_party/mlibc/sysdeps/
third_party/mlibc/sysdeps/*
!third_party/mlibc/sysdeps/extron/
# Most of this directory is supplied by the upstream checkout. Keep only
# Extron's locally maintained ABI delta visible to the parent repository.
third_party/mlibc/sysdeps/extron/include/abi-bits/*
!third_party/mlibc/sysdeps/extron/include/abi-bits/ioctls.h
third_party/mlibc/sysdeps/extron/include/paths.h
third_party/mlibc/sysdeps/extron/include/sys/ioctl.h

# The shareware WAD. Freely redistributable but 4MB of binary that would
# sit in every clone forever; fetch it into usr/ instead.
usr/*.wad
